# Local Django configuration. Replace both secrets before use.
# Compose serves the complete app at http://127.0.0.1:8000/.
APP_PORT=8000
DJANGO_SECRET_KEY=replace-with-a-random-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Exact frontend origins (scheme + host + port, no trailing slash).
# Local HTTP only: use the same hostname for frontend and API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Secure flags default to True with DJANGO_DEBUG=False, False for local debug.
# Truly cross-site HTTPS deployments need both SameSite=None and Secure=True.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# HTTPS reverse proxy only: trust its exact IP and overwrite forwarded headers there.
# Keep Django bound to loopback/private networking; never expose Ollama publicly.
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1
# DJANGO_SECURE_SSL_REDIRECT=True
# Enable only after every subdomain is HTTPS and the domain policy is agreed.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True
# SMTP is used only outside DEBUG. Configure before enabling email features.
# DJANGO_SMTP_HOST=smtp.example.com
# DJANGO_SMTP_PORT=587
# DJANGO_SMTP_USER=your-smtp-account
# DJANGO_SMTP_PASSWORD=your-smtp-password

# Host-side Django uses these values; Compose overrides host/port for db_setup.
POSTGRES_DB=agentdraft
POSTGRES_USER=agentdraft
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Production runtime role (separate from the bootstrap/migration administrator).
# See deployment/create_runtime_role.sql.example. Do not use the DB superuser in the public app.
# DJANGO_DB_USER=agentdraft_app
# DJANGO_DB_PASSWORD=replace-with-a-separate-random-application-password

# Initial password for demo_writer and demo_editor (at least 12 characters).
SEED_DEMO_PASSWORD=replace-with-a-random-demo-account-password

# Ollama stays on the host; GPU/model configuration remains in your local Ollama.
# Optional local Python override (default http://127.0.0.1:11434):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional container override (default http://host.docker.internal:11434):
# OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

