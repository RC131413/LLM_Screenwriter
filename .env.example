# Local Django configuration. Replace both secrets before use.
DJANGO_SECRET_KEY=replace-with-a-random-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Exact frontend origins (scheme + host + port, no trailing slash).
# Local HTTP only: use the same hostname for frontend and API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Secure flags default to True with DJANGO_DEBUG=False, False for local debug.
# Truly cross-site HTTPS deployments need both SameSite=None and Secure=True.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Host-side Django uses these values; Compose overrides host/port for db_setup.
POSTGRES_DB=agentdraft
POSTGRES_USER=agentdraft
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Initial password for demo_writer and demo_editor (at least 12 characters).
SEED_DEMO_PASSWORD=replace-with-a-random-demo-account-password

# Local Bielik hardware configuration. Restart Django after changes.
# Shell/container environment variables override this file.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 99 requests all GPU layers; auto lets Ollama choose; 0 uses CPU only.
# A positive smaller number requests that many GPU layers (partial offload).
OLLAMA_GPU_LAYERS=99
# Agent workflow batch size; smaller batches can reduce temporary VRAM needs.
OLLAMA_AGENT_BATCH_SIZE=64
# Default batch size for direct calls to backend.ollama.generate.
OLLAMA_BATCH_SIZE=128
# Allowed context windows, comma-separated. Larger windows require more memory.
# The fixed Bielik model supports up to 32768; hardware fit must be verified.
OLLAMA_CONTEXT_WINDOWS=2048,4096
OLLAMA_CONTEXT_MARGIN=128
# Socket timeouts in seconds. Slower CPU/partial-GPU configurations may need more.
OLLAMA_TIMEOUT=120
OLLAMA_SCENE_TIMEOUT=300
