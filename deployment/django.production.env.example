# Runtime process only. Keep bootstrap/migration superuser secrets OUT of this environment.
# Never ship the development root .env into the public application container/directory.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-generator
DJANGO_ALLOWED_HOSTS=agentdraft.example.com
CORS_ALLOWED_ORIGINS=https://agentdraft.example.com
CSRF_TRUSTED_ORIGINS=https://agentdraft.example.com
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True
POSTGRES_DB=agentdraft
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DJANGO_DB_USER=agentdraft_app
DJANGO_DB_PASSWORD=replace-with-the-separate-runtime-role-password
# Set SMTP only when a real mail provider is configured; STARTTLS is required.
# DJANGO_SMTP_HOST=smtp.example.com
# DJANGO_SMTP_PORT=587
# DJANGO_SMTP_USER=your-mail-account
# DJANGO_SMTP_PASSWORD=your-mail-password
