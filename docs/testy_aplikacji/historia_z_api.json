        },
        {
          "id": "6bb54d2f-1db8-46e3-bb82-f2051d4e1704",
          "text": "Dioda nagle gaśnie. Olek podnosi dyktafon i sprawdza baterię.",
          "type": "action"
        },
        {
          "id": "a1d30471-631f-45cf-9508-6f2860853b6b",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "9afe25d9-0c25-4a1f-b31c-78964e28d67f",
          "text": "Co się stało?",
          "type": "dialogue"
        },
        {
          "id": "0fb5170f-a4e7-484f-95de-23ac7643efd4",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "f269d133-a2c8-4f52-b020-a0dc580764b3",
          "text": "(Wzdycha i kręci głową.)",
          "type": "parenthetical"
        },
        {
          "id": "5e87241a-fdee-4402-80b9-979f04a0ecb7",
          "text": "Nie wiem. Może bateria się wyczerpała.",
          "type": "dialogue"
        },
        {
          "id": "777a4074-07ee-4650-841c-225d54c79f3b",
          "text": "Anna podchodzi i patrzy na urządzenie.",
          "type": "action"
        },
        {
          "id": "2ecba151-cdef-4e3f-8b0d-63ff06e87952",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "c01a1657-7945-41b9-bab6-7a1024b5e287",
          "text": "(Wskazuje na dyktafon.)",
          "type": "parenthetical"
        },
        {
          "id": "43fa5025-af74-43d6-a2a7-7cf4999bd22a",
          "text": "Można go naładować?",
          "type": "dialogue"
        },
        {
          "id": "0a9c6a85-fee5-44cd-8848-37bf03fb0bc4",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "e4144a8a-02b4-452b-85d6-b1a4ba62a0af",
          "text": "(Kręci głową.)",
          "type": "parenthetical"
        },
        {
          "id": "95cecd08-5dbb-4436-9003-9e1d2b77a962",
          "text": "Nie mamy ładowarki ani zasilacza. Ale może to ktoś celowo wyłączył.",
          "type": "dialogue"
        },
        {
          "id": "67b98d97-1d5b-47ee-936f-6ae3819c178d",
          "text": "Anna marszczy brwi i zastanawia się.",
          "type": "action"
        },
        {
          "id": "dd34a319-8cce-41e4-9f40-c44ad5ff6653",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "75ba51d3-8a14-4918-a8d9-b684135d8e30",
          "text": "(Wzdycha i kręci głową.)",
          "type": "parenthetical"
        },
        {
          "id": "6f0155a3-3d40-40cc-9dd1-8dea8e142901",
          "text": "To możliwe.",
          "type": "dialogue"
        },
        {
          "id": "567da3dc-a2f0-42cd-95cd-725108aa0401",
          "text": "Olek siada na krześle i opiera się o biurko.",
          "type": "action"
        },
        {
          "id": "d14ae942-6bb3-4829-abf4-5082fd2fb4af",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "e685ef23-8c5f-4beb-88f0-cbbea3baaf64",
          "text": "(Mówi z namysłem.)",
          "type": "parenthetical"
        },
        {
          "id": "b8d8efbe-39cd-4dfb-98ad-4a0efb4ea07e",
          "text": "Może powinniśmy zabezpieczyć nagranie w inny sposób.",
          "type": "dialogue"
        },
        {
          "id": "8a86c193-fcbf-428f-86af-6a9a7e390b73",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "cfe31d1d-7265-418b-a75c-1e2fe656ccd9",
          "text": "(Przygląda się Olkowi.)",
          "type": "parenthetical"
        },
        {
          "id": "b5f39c47-3ab6-46c5-afc6-153108084d86",
          "text": "Jak?",
          "type": "dialogue"
        },
        {
          "id": "92290326-9c1f-4a51-b0fa-06c2d96c7a71",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "0c8cbf34-656d-4b66-ad51-847dba1f4daa",
          "text": "(Wskazuje na telefon.)",
          "type": "parenthetical"
        },
        {
          "id": "42ca5cb0-296a-4039-8119-c642484ac48b",
          "text": "Na przykład skopiować je na telefon.",
          "type": "dialogue"
        },
        {
          "id": "b3a659d1-9451-45a7-8bb6-a4a389105b45",
          "text": "Anna się zastanawia.",
          "type": "action"
        },
        {
          "id": "a071aeb1-d298-44f9-b25d-1ef747121f80",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "f9319885-9e7b-42f2-b8bd-8e3c057bcd42",
          "text": "(Mówi z niepokojem.)",
          "type": "parenthetical"
        },
        {
          "id": "efd67ecf-b095-4601-935c-3188a6099240",
          "text": "Ale czy to bezpieczne, skoro ktoś już raz ingerował w nasze dowody?",
          "type": "dialogue"
        },
        {
          "id": "39ed65ec-e961-4531-b0b3-9f391af7272f",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "0d017eb2-e4cc-491d-a00b-3032673e9b56",
          "text": "(Kiwa głową.)",
          "type": "parenthetical"
        },
        {
          "id": "dac9487a-61b4-459c-937f-15b8c0a1c1e6",
          "text": "Racja. Musimy znaleźć trwalsze rozwiązanie.",
          "type": "dialogue"
        },
        {
          "id": "29f6c64e-7fa1-4a48-a212-627ea0a128fd",
          "text": "Anna przypomina sobie o metalowej kasetce.",
          "type": "action"
        },
        {
          "id": "516635b8-73c1-4c11-87bd-8107875229d5",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "d988d16d-5bb7-4d3a-8db7-410e835fbf83",
          "text": "(Mówi z nadzieją.)",
          "type": "parenthetical"
        },
        {
          "id": "0b95d472-ce72-4ddb-9a6b-fdb98fd3d118",
          "text": "Wiem! Możemy schować dyktafon w metalowej kasetce, w której trzymam ważne dokumenty.",
          "type": "dialogue"
        },
        {
          "id": "f65984e1-9d71-4931-aeeb-a7fd66e21304",
          "text": "Anna podchodzi do biurka i otwiera szufladę.",
          "type": "action"
        },
        {
          "id": "fe0c9efa-3228-4e3f-8975-b30db66e57cb",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "dd6d7a6e-c385-48f3-991e-ec344c9d7520",
          "text": "(Wyjmuje klucz.)",
          "type": "parenthetical"
        },
        {
          "id": "9188e444-51ac-4def-87fd-da27a7b2088f",
          "text": "Masz rację. To powinno być bezpieczne.",
          "type": "dialogue"
        },
        {
          "id": "12b1a743-0ab7-43ba-a701-13f1b06b1529",
          "text": "Anna otwiera kasetkę i wkłada do niej dyktafon.",
          "type": "action"
        },
        {
          "id": "3335afcb-0222-4cef-bade-0876e9384896",
          "text": "Anna zamyka kasetkę i odkłada ją na bok.",
          "type": "action"
        },
        {
          "id": "b0392c8b-2ecb-4a6e-a925-8b5a4d77d47f",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "aa6202fd-e569-4379-9b74-7706c626bba7",
          "text": "Czy ta kasetka jest bezpieczna?",
          "type": "dialogue"
        },
        {
          "id": "949ad489-3ac5-4963-8e13-13c8060aa5fa",
          "text": "ANNA",
          "type": "character"
        },
        {
          "id": "dcb6feba-69c1-4534-b3db-46ad18051554",
          "text": "(Uśmiecha się lekko.)",
          "type": "parenthetical"
        },
        {
          "id": "26244e7c-e5ea-4217-b821-f6b45a4ffe73",
          "text": "Tak. Nikt oprócz mnie nie zna kodu do sejfu, więc powinno być dobrze.",
          "type": "dialogue"
        },
        {
          "id": "d8f9e84f-7699-4008-b5dc-c1a0b0b83e67",
          "text": "OLEK",
          "type": "character"
        },
        {
          "id": "502f91f7-121a-41ad-baf8-538acd67a877",
          "text": "Dobrze. To nam wystarczy.",
          "type": "dialogue"
        }
      ],
